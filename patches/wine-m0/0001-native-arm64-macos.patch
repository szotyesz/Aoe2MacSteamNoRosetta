+    static _Thread_local int reported;
+    int translated = 0;
+    size_t size = sizeof(translated);
+    if (os_custom_x18_abi_enabled() || sysconf(_SC_PAGESIZE) != 4096) abort();
+    if (!reported && getenv("AOE2_M0_DIAGNOSTICS"))
+    {
+        if (sysctlbyname("sysctl.proc_translated", &translated, &size, NULL, 0) && errno != ENOENT)
+            abort();
+        if (translated) abort();
+        fprintf(stderr, "M0-NATIVE pages=4096 custom_x18=0 translated=0 pid=%d teb=%p\n",
+                getpid(), NtCurrentTeb());
+        reported = 1;
+    }
